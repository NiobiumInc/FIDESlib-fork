############### Configuration ###################

get_filename_component(FIDESLIB_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
if(NOT FIDESLIB_BINARY_DIR)
  include("${FIDESLIB_CMAKE_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

############### Macros ###################

include(CMakeFindDependencyMacro)

############### Exports ###################

set(FIDESLIB_INCLUDE_PATH "@CMAKE_INSTALL_PREFIX@/@INSTALL_INCLUDE_DIR@/@PROJECT_NAME@")
set(FIDESLIB_LIBRARIES_PATH "@CMAKE_INSTALL_PREFIX@/@INSTALL_LIBRARY_DIR@")
set(FIDESLIB_BINARY_PATH "@CMAKE_INSTALL_PREFIX@/@INSTALL_BINARY_DIR@")
set(FIDESLIB_DATA_PATH "@CMAKE_INSTALL_PREFIX@/@INSTALL_DATA_DIR@")

set(FIDESLIB_CXX_COMPILER "@CMAKE_CXX_COMPILER@")
set(FIDESLIB_CXX_FLAGS "@FIX_OMP_FLAGS@")

message(STATUS "Using FIDESlib.")

############### Link dependencies ###############

find_package(CUDAToolkit)

# haze (FHETCH) backend — re-create the haze::haze imported target when the package
# was built with FIDESLIB_ENABLE_HAZE=ON. Examples are standalone CMake projects that
# link the installed static fideslib; they need haze::haze to be resolvable here so
# libhaze.so propagates through fideslib's PUBLIC link requirements.
set(FIDESLIB_HAZE_DIR "@FIDESLIB_HAZE_DIR@")
if(FIDESLIB_HAZE_DIR AND NOT TARGET haze::haze)
  # haze artifact layout: build/libhaze.so, include/, replay_bridge/include/
  set(_HAZE_SO "${FIDESLIB_HAZE_DIR}/build/libhaze.so")
  if(EXISTS "${_HAZE_SO}")
    add_library(haze::haze SHARED IMPORTED GLOBAL)
    set_target_properties(haze::haze PROPERTIES
      IMPORTED_LOCATION "${_HAZE_SO}"
      INTERFACE_INCLUDE_DIRECTORIES
          "${FIDESLIB_HAZE_DIR}/include;${FIDESLIB_HAZE_DIR}/replay_bridge/include"
    )
  else()
    message(WARNING "FIDESlib was built with haze support (FIDESLIB_HAZE_DIR=${FIDESLIB_HAZE_DIR}) "
                    "but libhaze.so was not found at ${_HAZE_SO}.")
  endif()
endif()
