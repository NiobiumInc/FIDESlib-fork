# Generated by the Niobium FHE Application Design AI Assistant (FHEanna).
#
# Hardware operation check. test-hw runs the same program on the local
# simulator, the Fog's FUNC_SIM and the Fog FPGA, and reports each:
#   local fails               -> haze records the operation wrongly
#   local passes, FUNC_SIM fails -> the Fog replay service
#   only FPGA fails           -> the hardware path (data format, firmware, device)
# The two Fog targets need `fog login` and use one Fog job each.

NIX ?= nix develop ../.. --command
FPGA_TARGET ?= FOG
BIN := $(CURDIR)/build/hw_ops_check
RUN := $(CURDIR)/run

.PHONY: help build test-cpu test-local test-funcsim test-fpga test-hw clean

help:
	@echo "build         build hw_ops_check (gcc, in the repo's Nix shell)"
	@echo "test-cpu      FIDESlib CPU backend (checks the check itself)"
	@echo "test-local    haze, local simulator"
	@echo "test-funcsim  haze, Fog FUNC_SIM            (1 Fog job)"
	@echo "test-fpga     haze, Fog FPGA ($(FPGA_TARGET))  (1 Fog job)"
	@echo "test-hw       local, FUNC_SIM and FPGA in turn, then a summary"
	@echo "clean         remove run/ and build/"

build:
	$(NIX) sh -c 'cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j'

test-cpu:
	$(BIN) --cpu

test-local:
	@mkdir -p $(RUN)
	FIDESLIB_HAZE_RUNS_DIR=$(RUN)/haze-local $(BIN)

test-funcsim:
	@mkdir -p $(RUN)
	FIDESLIB_HAZE_RUNS_DIR=$(RUN)/haze-funcsim fog submit $(BIN) --target=FUNC_SIM

test-fpga:
	@mkdir -p $(RUN)
	FIDESLIB_HAZE_RUNS_DIR=$(RUN)/haze-fpga fog submit $(BIN) --target=$(FPGA_TARGET)

# Runs all three even when one fails, so the summary always shows where it broke.
test-hw:
	@mkdir -p $(RUN); fail=0; \
	for t in local funcsim fpga; do \
	  echo "=== $$t"; \
	  if $(MAKE) --no-print-directory test-$$t > $(RUN)/$$t.log 2>&1; then r=PASS; else r=FAIL; fail=1; fi; \
	  sed -n '/^hw_ops_check:/,/^ALL PASS\|FAILED (/p' $(RUN)/$$t.log; \
	  echo "$$t: $$r" >> $(RUN)/summary.tmp; \
	done; \
	echo "=== summary"; cat $(RUN)/summary.tmp; rm -f $(RUN)/summary.tmp; exit $$fail

clean:
	rm -rf run/ build/
